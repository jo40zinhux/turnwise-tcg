{
    "gameId": "one_piece",
    "name": "One Piece Card Game",
    "phases": [
        {
            "id": "refresh",
            "title": "Refresh Phase",
            "description": "Desvire todas as cartas e DON!! utilizados.",
            "iconCode": "refresh"
        },
        {
            "id": "draw",
            "title": "Draw Phase",
            "description": "Compre 1 carta do topo do baralho.",
            "iconCode": "copy_outlined"
        },
        {
            "id": "don",
            "title": "DON!! Phase",
            "description": "Adicione até 2 cartas DON!! da DON!! Deck para sua área de custo.",
            "iconCode": "bolt"
        },
        {
            "id": "main",
            "title": "Main Phase",
            "description": "Jogue personagens, eventos, equipe DON!! e ative efeitos.",
            "iconCode": "back_hand_rounded"
        },
        {
            "id": "battle",
            "title": "Battle Phase",
            "description": "Ataque com Leader ou Characters e resolva batalhas.",
            "iconCode": "sports_mma"
        },
        {
            "id": "end",
            "title": "End Phase",
            "description": "Resolva efeitos de fim de turno.",
            "iconCode": "dark_mode"
        }
    ],
    "actions": [
        {
            "id": "add_don",
            "name": "Adicionar DON!!",
            "allowedPhases": ["don"],
            "validations": ["don_add_limit"],
            "trackUsage": true
        },
        {
            "id": "attach_don",
            "name": "Anexar DON!!",
            "allowedPhases": ["main"],
            "validations": [],
            "trackUsage": true,
            "requiresTarget": true
        },
        {
            "id": "play_character",
            "name": "Jogar Character",
            "allowedPhases": ["main"],
            "validations": ["don_cost_check"],
            "trackUsage": true
        },
        {
            "id": "play_event",
            "name": "Jogar Event",
            "allowedPhases": ["main", "battle"],
            "validations": ["don_cost_check"],
            "trackUsage": true
        },
        {
            "id": "play_stage",
            "name": "Jogar Stage",
            "allowedPhases": ["main"],
            "validations": ["stage_limit"],
            "trackUsage": true
        },
        {
            "id": "activate_main",
            "name": "Ativar Main Effect",
            "allowedPhases": ["main"],
            "validations": [],
            "trackUsage": true
        },
        {
            "id": "attack",
            "name": "Declarar Ataque",
            "allowedPhases": ["battle"],
            "validations": ["rested_check"],
            "trackUsage": true,
            "requiresTarget": true
        },
        {
            "id": "counter",
            "name": "Usar Counter",
            "allowedPhases": ["battle"],
            "validations": [],
            "trackUsage": true
        }
    ],
    "validations": [
        {
            "id": "don_add_limit",
            "type": "limit",
            "params": {"max": 2},
            "errorMessage": "Você só pode adicionar até 2 DON!! por turno."
        },
        {
            "id": "stage_limit",
            "type": "limit",
            "params": {"max": 1},
            "errorMessage": "Você só pode ter uma carta Stage ativa."
        },
        {
            "id": "don_cost_check",
            "type": "resource",
            "params": {},
            "errorMessage": "Você não possui DON!! suficiente para esta ação."
        },
        {
            "id": "rested_check",
            "type": "condition",
            "params": {"requires": "character_active"},
            "errorMessage": "Characters descansados não podem atacar."
        },
        {
            "id": "first_player_skip_draw",
            "type": "first_player_first_turn",
            "params": {"phase": "draw"},
            "errorMessage": "O primeiro jogador não compra carta no primeiro turno."
        }
    ],
    "statusEffects": [],
    "metadata": {
        "themeColor": "blueAccent",
        "iconCode": "sailing",
