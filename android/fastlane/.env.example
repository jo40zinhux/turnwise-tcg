# Copia para android/fastlane/.env (nunca commitar)
#
# Fastlane Android: apenas upload de AAB para o Google Play Console.
# Publicação em produção → manual no Play Console.
#
# 1. Play Console → Setup → API access → ligar projeto Google Cloud
# 2. Criar Service Account com permissão na app (Release manager ou Admin)
# 3. Descarregar JSON e colocar o caminho abaixo (ex.: android/fastlane/play-store-key.json)

PLAY_STORE_JSON_KEY_PATH=
