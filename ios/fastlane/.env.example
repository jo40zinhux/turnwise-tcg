# Copia para ios/fastlane/.env (nunca commitar)
#
# Fastlane iOS: apenas upload para App Store Connect / TestFlight.
# Promover para App Store (produção) → manual no App Store Connect.

APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_PATH=

